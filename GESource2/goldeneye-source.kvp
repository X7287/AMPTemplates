App.AdminMethod=SourceRCON
App.ApplicationPort1=27015
App.ApplicationPort2=27015
App.ApplicationReadyMode=RCONConnected
App.BaseDirectory=./goldeneye-source/310/
App.CommandLineArgs=-game gesource -console {{$PlatformArgs}} {{$FormattedArgs}} +rcon_password {{$RemoteAdminPassword}} {{$ApplicationPort2}}
App.CommandLineParameterDelimiter= 
App.CommandLineParameterFormat=-{0} "{1}"
App.DisplayName=GoldenEye: Source
App.EnvironmentVariables={"LD_LIBRARY_PATH": "./linux64:%LD_LIBRARY_PATH%", "SteamAppId": "310"}
App.ExecutableLinux=310/
App.ExecutableWin=310\srcds.exe
App.ExitMethod=OS_CLOSE
App.ExitString=stop
App.HasReadableConsole=true
App.HasWritableConsole=true
App.RapidStartup=false
App.RemoteAdminPort=27015
App.RootDir=./goldeneye-source/
App.UpdateSource=Multi
App.UpdateSources=[{"UpdateStageName": "SteamCMD Download","UpdateSourcePlatform": "All", "UpdateSource": "SteamCMD", "UpdateSourceData": "310"}]
App.WorkingDir=310
Console.AppReadyRegex=^Server is ready.$
Console.ThrowawayMessageRegex=^(WARNING|ERROR): Shader.+$
Console.UserChatRegex=^(?<username>.+?): (?<message>.+)$
Console.UserJoinRegex=^User (?<username>.+?) \((?<userid>-?d+)\) connected from \[::ffff:(?<endpoint>.+?)\]$
Console.UserLeaveRegex=^User (?<username>.+?) \((?<userid>-?d+)\) disconnected\. Reason: (.+?)$
Meta.Author=Zach
Meta.ConfigManifest=goldeneye-sourceconfig.json
Meta.ConfigRoot=goldeneye-source.kvp
Meta.Description=GoldenEye: Source Dedicated Server
Meta.DisplayImageSource=steam:
Meta.DisplayName=GoldenEye: Source
Meta.EndpointURIFormat=steam://connect/{ip}/{GenericModule.App.ApplicationPort2}
Meta.OS=1
Meta.URL=https://geshl2.com/